# Variáveis do FRONTEND (copie para .env.local se precisar mudar) - [Deyvidsk10]

# Por padrão o front chama a API pelo proxy "/backend" do Next.js (nada a configurar).
# Se quiser chamar a API direto (ex.: URL pública da porta 3001 no Codespaces), defina:
# NEXT_PUBLIC_API_URL=https://seu-codespace-3001.app.github.dev

# Endereço interno da API usado pelo proxy do Next.js
# API_INTERNAL_URL=http://localhost:3001
